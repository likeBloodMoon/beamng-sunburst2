        ["$ecuPowerMultiplier", "range", "x", "Deluxe ECU", 1.0, 0.2, 5.0, "Power Multiplier", "Scales the whole torque curve at runtime, whatever engine is fitted", {"stepDis":0.1}],
        ["$revLimiterRPM", "range", "rpm", "Deluxe ECU", 7200, 4500, 9500, "Rev Limiter RPM", "RPM where the rev limiter prevents further revving", {"stepDis":50}],
        ["$revLimiterCutTime", "range", "s", "Deluxe ECU", 0.08, 0.01, 0.5, "Rev Limiter Cut Time", "How fast the rev limiter cycles", {"stepDis":0.01}],
        ["$wastegateTarget", "range", "psi", "Deluxe ECU", 20, 5, 30, "Wastegate Target Pressure", "Target pressure at which the wastegate begins to open (only relevant with a turbo fitted)", {"stepDis":0.5}]
